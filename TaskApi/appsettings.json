{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=taskdb;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "Exchange": "task.events",
    "RoutingKey": "task.completed",
    "ShutdownDrainSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
